{
  "expo": {
    "name": "KYVON",
    "slug": "meu-controle-financeiro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.aureliorm.meucontrole"
    },
    "android": {
      "package": "com.aureliorm.meucontrole",
      "adaptiveIcon": {
        "foregroundImage": "./assets/kyvon-k.png",
        "backgroundColor": "#060708"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font"
    ],
    "icon": "./assets/kyvon-k.png",
    "splash": {
      "image": "./assets/kyvon-k.png",
      "resizeMode": "contain",
      "backgroundColor": "#060708"
    }
  }
}
